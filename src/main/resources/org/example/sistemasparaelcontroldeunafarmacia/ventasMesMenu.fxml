                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </HBox>
                  <HBox fx:id="contenedorBuscador" alignment="CENTER" maxWidth="-Infinity" prefHeight="28.0" prefWidth="557.0" spacing="20.0" styleClass="contenedorBuscador">
                     <children>
                        <TextField alignment="TOP_LEFT" minHeight="-Infinity" minWidth="-Infinity" prefHeight="41.0" prefWidth="528.0" styleClass="campoBuscador" HBox.hgrow="ALWAYS" />
