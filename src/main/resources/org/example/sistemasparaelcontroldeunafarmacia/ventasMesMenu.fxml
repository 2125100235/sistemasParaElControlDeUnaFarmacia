                        <FontAwesomeIconView glyphName="SEARCH" size="25" strokeType="INSIDE">
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </FontAwesomeIconView>
                     </children>
                     <padding>
