      </Label>
      <BorderPane prefHeight="200.0" prefWidth="200.0">
         <top>
            <VBox alignment="CENTER" prefHeight="72.0" prefWidth="960.0" BorderPane.alignment="CENTER">
               <children>
                  <HBox alignment="CENTER" prefHeight="68.0" prefWidth="960.0" spacing="20.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblTitulo" alignment="CENTER" prefHeight="56.0" prefWidth="305.0" text="Ventas por mes" textOverrun="CLIP">
